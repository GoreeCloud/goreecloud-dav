# GoreeCloud DAV development configuration.
# Do not place real credentials in source control.
# If set, GOREECLOUD_DAV_USERNAME is also the development DAV principal ID
# and may contain only letters, digits, '-' and '_'.
GOREECLOUD_DAV_LISTEN=127.0.0.1:5232
GOREECLOUD_DAV_DATA_DIR=./data
GOREECLOUD_DAV_USERNAME=
GOREECLOUD_DAV_PASSWORD=
GOREECLOUD_DAV_MAX_BODY_BYTES=10485760
